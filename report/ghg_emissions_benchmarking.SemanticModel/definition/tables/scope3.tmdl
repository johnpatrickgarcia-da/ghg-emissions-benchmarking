table scope3
	lineageTag: 158b58eb-9d14-43ac-a321-265c770ebdf7

	measure 'Scope 3 Tree Title' =
			
			"Share of Reported Scope 3 by Category, "
			    & SELECTEDVALUE ( fiscal_year[fiscal_year], "all years" )
		isHidden
		lineageTag: 3855e502-eaf1-4b33-be04-ff28f750ab54

		changedProperty = IsHidden

	measure 'S12 (Mt)' = CALCULATE(SUM(emissions[value_mt]),emissions[scope]IN{"Scope 1","Scope 2 (market-based)"})
		formatString: " #,0.00"" million t"""
		isHidden
		lineageTag: 075dc503-4115-44a8-83a2-a8c1cd2e7c61

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Cat 11 (Mt)' = CALCULATE(SUM(scope3[value_mt]),scope3[category_no]=11)
		formatString: " #,0.00"" million t"""
		isHidden
		lineageTag: 64481b80-6cba-4a10-b91a-1953115af318

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Other Scope 3 (Mt)' = SUM(scope3[value_mt])-scope3[Cat 11 (Mt)]
		formatString: " #,0.00"" million t"""
		isHidden
		lineageTag: 3547f293-3b0b-4713-9ad8-8fcfad905d16

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Scope 1+2 vs 3 Stacked Title' =
			
			"Scope 1+2 vs Scope 3, "
			    & SELECTEDVALUE ( fiscal_year[fiscal_year], "all years" )
			    & " (share of reported total)"
		isHidden
		lineageTag: d8a1112c-4b6e-4846-879c-e4f9aaa3d47f

		changedProperty = IsHidden

	measure 'Scope 3 Share' =
			
			DIVIDE(
			    SUM(scope3[value_mt]),
			    CALCULATE(
			        SUM(scope3[value_mt]),
			        REMOVEFILTERS(scope3[Stream], scope3[Category], scope3[category_no], scope3[category_name])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		lineageTag: 6b11e8be-d6dd-44c8-a6e6-3aa63ab71afe

		changedProperty = IsHidden

	measure 'Cat 11 Share Text' =
			
			VAR _shares =
			    ADDCOLUMNS(
			        ALL(fundamentals[company_name]),
			        "@c11", DIVIDE([Cat 11 (Mt)], CALCULATE(SUM(scope3[value_mt]))),
			        "@c1",  DIVIDE(
			                    CALCULATE(SUM(scope3[value_mt]), scope3[category_no] = 1),
			                    CALCULATE(SUM(scope3[value_mt]))
			                )
			    )
			VAR _valid = FILTER(_shares, NOT ISBLANK([@c11]))
			VAR _avg11 = AVERAGEX(_valid, [@c11])
			VAR _min11 = MINX(_valid, [@c11])
			VAR _max11 = MAXX(_valid, [@c11])
			VAR _avg1  = AVERAGEX(_valid, [@c1])
			VAR _min1  = MINX(_valid, [@c1])
			VAR _max1  = MAXX(_valid, [@c1])
			VAR _n = COUNTROWS(_valid)
			RETURN
			    "Category 11 (use of sold products) averages " & FORMAT(_avg11, "0%")
			        & " of reported Scope 3 across " & IF(_n = 4, "the four companies", _n & " companies")
			        & " (range " & FORMAT(_min11, "0%") & "–" & FORMAT(_max11, "0%") & ") in "
			        & SELECTEDVALUE(fiscal_year[fiscal_year]) & ". "
			        & "Category 1 (purchased goods and services) is second, averaging "
			        & FORMAT(_avg1, "0%")
			        & " (range " & FORMAT(_min1, "0%") & "–" & FORMAT(_max1, "0%") & ")."
		isHidden
		lineageTag: 6ece985e-7ea1-4b48-88fa-ebe3d178e95b

		changedProperty = IsHidden

	measure 'S12 Share Text' =
			
			VAR _shares =
			    ADDCOLUMNS(
			        ALL(fundamentals[company_name]),
			        "@share",
			            DIVIDE([S12 (Mt)], [S12 (Mt)] + CALCULATE(SUM(scope3[value_mt])))
			    )
			VAR _valid = FILTER(_shares, NOT ISBLANK([@share]))
			RETURN
			    "Operational (Scope 1+2) emissions are only "
			        & FORMAT(MINX(_valid, [@share]), "0.0%") & "–" & FORMAT(MAXX(_valid, [@share]), "0.0%")
			        & " of each company's reported footprint in " & SELECTEDVALUE(fiscal_year[fiscal_year])
			        & "; most comes from customers' use of sold vehicles (Category 11)."
		isHidden
		lineageTag: da7601b7-1d2b-4838-95f6-ef2746139a8b

		changedProperty = IsHidden

