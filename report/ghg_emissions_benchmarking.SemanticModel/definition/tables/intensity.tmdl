table intensity
	lineageTag: 5a523237-e68b-4b64-b0d0-1741a3d728a1

	measure 'Scope 1+2 Intensity Bar Title' =
			
			"Scope 1+2 Intensity, "
			    & SELECTEDVALUE ( fiscal_year[fiscal_year], "all years" )
			    & " (t CO₂/CO₂e per ¥ billion revenue)"
		lineageTag: a610334d-7524-4974-952d-7bc753d5edb0

	measure 'Company Tooltip Header' =
			
			SELECTEDVALUE ( fundamentals[company_name] ) & " · "
			    & SELECTEDVALUE ( fiscal_year[fiscal_year] )
		lineageTag: d58205a8-0e27-470f-8476-a920fc193cbc

