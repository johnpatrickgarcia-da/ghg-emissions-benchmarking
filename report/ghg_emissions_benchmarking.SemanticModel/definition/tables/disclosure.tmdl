	partition disclosure = m
		mode: import
		source =
				let
				  Source = Table.Combine({disc_scope, disc_cat}),
				  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(Source, "scope_group", each if Text.StartsWith([row_label], "Scope 3") then "Scope 3 Total"
				else if Text.StartsWith([row_label], "Scope") then "Scope 1 & 2"
				else if Number.From(Text.BetweenDelimiters([row_label], "Cat ", ".")) <= 8 then "Upstream (Cat 1–8)"
				else "Downstream (Cat 9–15)"), {{"scope_group", type text}}),
				  #"Added custom 1" = Table.TransformColumnTypes(Table.AddColumn(#"Added custom", "scope_group_order", each if [scope_group] = "Scope 1 & 2" then 1
				else if [scope_group] = "Scope 3 Total" then 2
				else if Text.StartsWith([scope_group], "Upstream") then 3
				else 4), {{"scope_group_order", Int64.Type}})
				in
				  #"Added custom 1"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

