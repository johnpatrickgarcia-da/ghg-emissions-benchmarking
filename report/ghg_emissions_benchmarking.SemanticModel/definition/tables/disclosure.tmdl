table disclosure
	lineageTag: cc45c9ee-27bf-4c15-ad2f-a49a98f64aca

	measure 'Disclosure Cell' =
			
			VAR _row       = SELECTEDVALUE ( disclosure[row_label] )
			VAR _disclosed = SELECTEDVALUE ( disclosure[disclosed] )
			VAR _assurance = SELECTEDVALUE ( disclosure[assurance_status] )
			VAR _notes     = SELECTEDVALUE ( disclosure[assurance_notes] )
			VAR _gas       = SELECTEDVALUE ( disclosure[gas_basis] )
			VAR _cats      = SELECTEDVALUE ( scope3_summary[categories_disclosed] )
			VAR _origAssured =
			    _assurance = "No Assurance"
			        && ( LEFT ( _notes, 8 ) = "Verified"
			             || LEFT ( _notes, 23 ) = "Original value verified" )
			VAR _assShort =
			    SWITCH (
			        TRUE (),
			        _origAssured, "Limited (original report)",
			        _assurance = "Limited Assurance",    "Limited",
			        _assurance = "Reasonable Assurance", "Reasonable",
			        _assurance = "No Assurance",         "No Assurance",
			        _assurance
			    )
			VAR _base = _assShort & UNICHAR ( 10 ) & _gas
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _disclosed ),  BLANK (),
			        _disclosed = "No",       "Not disclosed",
			        _row = "Scope 3 Total",  _base & UNICHAR ( 10 ) & _cats & "/15 categories reported",
			        _base
			    )
		isHidden
		lineageTag: d4be3648-bb09-4531-b6e7-0562e4b56b90

		changedProperty = IsHidden

	measure 'Disclosure Colour' =
			
			VAR _disclosed = SELECTEDVALUE ( disclosure[disclosed] )
			VAR _assurance = SELECTEDVALUE ( disclosure[assurance_status] )
			VAR _notes     = SELECTEDVALUE ( disclosure[assurance_notes] )
			VAR _origAssured =
			    _assurance = "No Assurance"
			        && ( LEFT ( _notes, 8 ) = "Verified"
			             || LEFT ( _notes, 23 ) = "Original value verified" )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _disclosed ), BLANK (),
			        _disclosed = "No",      "#EF9A9A",
			        _assurance IN { "Limited Assurance", "Reasonable Assurance" }, "#A5D6A7",
			        _origAssured,           "#DCEDC8",
			        "#FFE082"
			    )
		isHidden
		lineageTag: 80d27bf2-2cf8-4e50-b2a1-f9834c733965

		changedProperty = IsHidden

	measure 'Heatmap Title' =
			
			"Disclosure & Assurance Status by Scope and Category, "
			    & SELECTEDVALUE ( fiscal_year[fiscal_year] )
		isHidden
		lineageTag: a1e94812-81de-4ca3-848a-135ce715e6be

		changedProperty = IsHidden

	measure 'Disclosure Assurance Note' =
			
			VAR _n = SELECTEDVALUE ( disclosure[assurance_notes] )
			RETURN IF ( ISBLANK ( _n ) || _n = "", "—", _n )
		isHidden
		lineageTag: e1aac9d7-48bd-43e6-8b62-2ee28c315d83

		changedProperty = IsHidden

	measure 'Disclosure Methodology Note' =
			
			VAR _n = SELECTEDVALUE ( disclosure[methodology_notes] )
			RETURN IF ( ISBLANK ( _n ) || _n = "", "—", _n )
		isHidden
		lineageTag: 124ad91f-71d7-4314-8d3d-866d1139ddce

		changedProperty = IsHidden

	measure 'Disclosure Source' =
			
			VAR _doc  = SELECTEDVALUE ( disclosure[source_document] )
			VAR _page = SELECTEDVALUE ( disclosure[source_page] )
			RETURN
			    IF ( ISBLANK ( _doc ), "—",
			         _doc & IF ( ISBLANK ( _page ) || _page = "", "", ", p." & _page ) )
		isHidden
		lineageTag: 20dea9cd-950d-4db8-88ef-5dc0c67b4a1b

		changedProperty = IsHidden

	measure 'Tooltip Header' =
			
			SELECTEDVALUE ( fundamentals[company_name] ) & " · "
			    & SELECTEDVALUE ( disclosure[row_label] )
		isHidden
		lineageTag: 4137e2d7-5d1d-4037-8a8a-e92b733feb0d

		changedProperty = IsHidden

